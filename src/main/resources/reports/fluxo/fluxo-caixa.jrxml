            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="46" width="802" height="11"/>
                <textFieldExpression><![CDATA[$P{geradoEm}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <detail>
