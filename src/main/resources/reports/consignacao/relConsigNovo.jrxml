	<pageFooter>
		<band height="98" splitType="Stretch">
			<staticText>
				<reportElement x="1" y="27" width="170" height="70" uuid="8af4b5c9-36e0-4671-816d-d6a53c952068"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Tabela de comissão:
-ACIMA DE R$ 80,00     : 20% DESCONTO
-ACIMA DE R$ 250,00   : 30% DESCONTO
-ACIMA DE R$ 650,00   : 35% DESCONTO
-ACIMA DE R$ 1200,00 : 40% DESCONTO
-KIT TODO                     : 50% DESCONTO       ]]></text>
			</staticText>
			<line>
				<reportElement x="0" y="-1" width="569" height="1" uuid="801d8214-ff79-44a7-a870-6292bccb5b69"/>
			</line>
			<staticText>
				<reportElement x="172" y="34" width="188" height="60" uuid="b2ee0f9f-080e-4373-8e5e-9a4ef68eeb58"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="8" isBold="true"/>
					<paragraph lineSpacingSize="1.0"/>
				</textElement>
				<text><![CDATA[*Somente aplicar comissão 
para pagamento feito na DATA do ACERTO.
*Favor conferir a mercadoria antes de  assinar.
*Será cobrado os produtos que estiverem  com a embalagem violada ou lacre rompido.]]></text>
			</staticText>
			<staticText>
				<reportElement x="356" y="47" width="199" height="10" uuid="8d5b28fd-43ec-4bed-be28-32cb3d7568e8"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="7" isBold="true"/>
				</textElement>
				<text><![CDATA[Ass. do recebimento da mercadoria]]></text>
			</staticText>
			<line>
				<reportElement x="339" y="47" width="231" height="1" uuid="b41b0290-3991-4c19-a1d6-550d3daa0d0f"/>
				<graphicElement>
					<pen lineWidth="0.7"/>
				</graphicElement>
			</line>
			<staticText>
				<reportElement x="370" y="60" width="199" height="32" uuid="0fa4a578-3b3e-426d-8155-7f67531a6299"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[O não pagamento desta venda, na data do vencimento, implicará em cobrança judicial e até inclusão no SPC e SERASA.]]></text>
			</staticText>
			<textField>
				<reportElement x="0" y="0" width="568" height="20" uuid="c29cb761-eadb-4b46-afed-6c2d11232b7f"/>
				<textElement markup="html">
					<font isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["<b>Nº: </b>"+$F{ID}+"&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"+"<b>"+$F{DataConsignacao}.toString().substring(8,10)+$F{DataConsignacao}.toString().substring(5,7)+$F{DataConsignacao}.toString().substring(2,4)+"</b>"+"&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"+ "<b>KIT: </b>"+$F{NuConsig}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="10" y="0" width="558" height="20" uuid="d1c778c5-0d00-40e1-9ad5-3460099d7472">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Right" markup="html">
					<font isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["<b>Total de Produtos: </b>"+$F{QTDEPecas}+"&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"+"<b>Valor Total: R$ </b>"+new BigDecimal($F{ValorTotal}).setScale(2, BigDecimal.ROUND_HALF_EVEN).toString().replace(".",",")]]></textFieldExpression>
