				<textFieldExpression><![CDATA["<b>Total de Produtos: </b>"+$F{qtdProdutos}+"&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"+"<b>Valor Total: R$ </b>"+new BigDecimal($F{valorTotal}).setScale(2, BigDecimal.ROUND_HALF_EVEN).toString().replace(".",",")]]></textFieldExpression>
			</textField>
			<image scaleImage="FillFrame">
				<reportElement x="0" y="13" width="569" height="50" uuid="d9a42645-39ae-451a-ab01-447cacdf7615">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<imageExpression><![CDATA[$P{rodape}]]></imageExpression>
			</image>
		</band>
	</pageFooter>
</jasperReport>
