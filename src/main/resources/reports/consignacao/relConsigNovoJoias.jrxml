	<queryString>
		<![CDATA[SELECT sistemadb.tb_consignacoes.`ID`,
	sistemadb.tb_consignacoes.`DataConsignacao`,
	sistemadb.tb_consignacoes.`ValorTotal`,
	sistemadb.tb_consignacoes.`QTDEPecas`,
	sistemadb.tb_consignacoesprodutos.`CodProduto`,
	sistemadb.tb_consignacoesprodutos.`NomeProduto`,
	sistemadb.tb_consignacoesprodutos.`ValorProdutoU`,
	sistemadb.tb_consignacoesprodutos.`QtdeProduto`,
	sistemadb.tb_consignacoesprodutos.`TipoProduto`,
	sistemadb.tb_consignacoes.`NuConsig`
FROM sistemadb.tb_consignacoes
	INNER JOIN sistemadb.tb_consignacoesprodutos ON 
	 sistemadb.tb_consignacoesprodutos.`IDConsignacao` = sistemadb.tb_consignacoes.`ID` 
ORDER BY sistemadb.tb_consignacoesprodutos.`TipoProduto` DESC]]>
	</queryString>
