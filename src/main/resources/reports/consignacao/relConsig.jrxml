	<queryString>
		<![CDATA[SELECT sistemadb.tb_consignacoes.`ID`,
	sistemadb.tb_consignacoes.`DataConsignacao`,
	sistemadb.tb_consignacoes.`CodCliente`,
	sistemadb.tb_consignacoes.`NomeCliente`,
	sistemadb.tb_consignacoes.`ValorTotal`,
sistemadb.tb_consignacoes.`QTDEPecas`,
	sistemadb.tb_consignacoesprodutos.`CodProduto`,
	sistemadb.tb_consignacoesprodutos.`NomeProduto`,
	sistemadb.tb_consignacoesprodutos.`ValorProdutoU`,
	sistemadb.tb_consignacoesprodutos.`QtdeProduto`,
	sistemadb.tb_consignacoesprodutos.`TipoProduto`,
	sistemadb.tb_clientes.`CodCliente`,
	sistemadb.tb_clientes.`TipoCliente`,
	sistemadb.tb_clientes.`Nome`,
	sistemadb.tb_clientes.`CPF_CNPJ`,
	sistemadb.tb_clientes.`Identidade`,
	sistemadb.tb_clientes.`DataNascimento`,
	sistemadb.tb_clientes.`CEP`,
	sistemadb.tb_clientes.`Endereco`,
	sistemadb.tb_clientes.`Complemento`,
	sistemadb.tb_clientes.`NuCasa`,
	sistemadb.tb_clientes.`Cidade`,
	sistemadb.tb_clientes.`Bairro`,
	sistemadb.tb_clientes.`UF`,
	sistemadb.tb_clientes.`Filiacao`,
	sistemadb.tb_clientes.`Celular1`,
	sistemadb.tb_clientes.`Celular2`,
	sistemadb.tb_consignacoes.`NuConsig`
FROM sistemadb.tb_consignacoes
	INNER JOIN sistemadb.tb_consignacoesprodutos ON 
	 sistemadb.tb_consignacoesprodutos.`IDConsignacao` = sistemadb.tb_consignacoes.`ID` 
	INNER JOIN sistemadb.tb_clientes ON 
	 sistemadb.tb_clientes.`CodCliente` = sistemadb.tb_consignacoes.`CodCliente` 
ORDER BY sistemadb.tb_consignacoesprodutos.`TipoProduto` DESC]]>
	</queryString>
